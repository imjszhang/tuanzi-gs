/** Real loopback production server + CLI + streaming provider. No external service. */
import test from 'node:test';import assert from 'node:assert/strict';import http from 'node:http';import {spawn} from 'node:child_process';import {once} from 'node:events';import fs from 'node:fs';import os from 'node:os';import path from 'node:path';
import {proposal,program} from './fixtures/adaptive-v05.mjs';import {generationHistory} from '../dist/src/lab/generation.js';
const sleep=ms=>new Promise(r=>setTimeout(r,ms));
async function cli(base,...args){const c=spawn(process.execPath,['bin/gs-lab.mjs',...args,'--url',base],{cwd:process.cwd(),env:{...process.env,GS_LAB_ACTOR:'agent:revision052'}});let out='',err='';c.stdout.on('data',d=>out+=d);c.stderr.on('data',d=>err+=d);const [code]=await once(c,'close');assert.equal(code,0,err);return JSON.parse(out);}
test('052 CLI and production HTTP recover format -> meta S -> actual action with separated ledger',async()=>{
 const p=proposal(program('仅协议夹具：执行一次等待',['wait'],{until:[{kind:'delta',field:'turn',atLeast:1}],maxActions:2}));let sCount=0;const calls=[];
 const upstream=http.createServer(async(req,res)=>{let raw='';for await(const c of req)raw+=c;const b=JSON.parse(raw),u=JSON.parse(b.messages[1].content);calls.push(b);
  if(u.outputContract){const repair=!!u.repair,content=JSON.stringify(repair?p:{actionFrame:p.proposals[0]});res.writeHead(200,{'content-type':'text/event-stream'});res.write('data: '+JSON.stringify({model:'MOCK_ONLY_G_052',choices:[{index:0,delta:{content:content.slice(0,80)},finish_reason:null}]})+'\n\n');res.end('data: '+JSON.stringify({model:'MOCK_ONLY_G_052',choices:[{index:0,delta:{content:content.slice(80)},finish_reason:'stop'}]})+'\n\ndata: [DONE]\n\n');}
  else {sCount++;const answers={};for(const [id,q]of Object.entries(u.questions)){let pick='none';if(sCount>0)pick=Object.keys(q.criteria).find(x=>x!=='none');answers[id]={type:'choice',choice:pick,confidence:1,probabilities:Object.fromEntries(Object.keys(q.criteria).map(k=>[k,k===pick?1:0]))};}res.writeHead(200,{'content-type':'application/json'});res.end(JSON.stringify({model:'MOCK_ONLY_S_052',choices:[{message:{content:JSON.stringify({answers})}}]}));}
 });await new Promise(r=>upstream.listen(0,'127.0.0.1',r));
 const d=http.createServer();await new Promise(r=>d.listen(0,'127.0.0.1',r));const port=d.address().port;await new Promise(r=>d.close(r));const base=`http://127.0.0.1:${port}`,dir=fs.mkdtempSync(path.join(os.tmpdir(),'gs-v052-'));
 const child=spawn(process.execPath,['server.mjs'],{env:{...process.env,PORT:String(port),TYPESAFE_API_KEY:'',LLM_URL:`http://127.0.0.1:${upstream.address().port}/chat`,LLM_MODEL:'MOCK_ONLY_052',LLM_API_KEY:'MOCK052_SECRET',LLM_STREAM:'true',LLM_THINKING:'',LLM_REASONING_EFFORT:'',GS_LAB_OUTPUT_DIR:dir,MAX_SERVER_CALLS:'20'},stdio:'ignore'});
 try{let ready=false;for(let i=0;i<100;i++){try{if((await fetch(base+'/api/status')).ok){ready=true;break;}}catch{}await sleep(30);}assert.ok(ready);
 const run=await cli(base,'create','--kind','game','--controller','adaptive','--backend','llm','--generator','llm','--strategy','direct','--allow-live','--max-requests','8','--max-g-calls','3','--max-revisions','1','--max-format-repairs','1','--deadline-ms','15000');assert.equal(run.config.maxFormatRepairs,1);
 const step=await cli(base,'step',run.runId);assert.equal(step.state.physicalActions,1);assert.equal(step.state.diagnostics.outputAccounting.formatRepairs,1);assert.equal(step.state.diagnostics.outputAccounting.revisionAttempts,1);assert.equal(step.state.diagnostics.metaCalls,1);
 const status=await cli(base,'status',run.runId);assert.deepEqual(status.world,step.state.world);const token=(await(await fetch(base+'/api/status')).json()).token;const ex=await(await fetch(base+`/api/lab/runs/${run.runId}/export`,{headers:{'x-gs-token':token}})).json();
 assert.equal(ex.ledger.requests,4);assert.deepEqual(ex.ledger.rows.filter(r=>r.questions===0).map(r=>r.purpose),['initialization','output-repair']);const streams=generationHistory(ex.events);assert.equal(streams.length,2);assert.equal(streams[0].status,'invalid');assert.equal(streams[1].cause,'output_format_invalid');assert.equal(streams[1].status,'complete');assert.ok(!JSON.stringify(ex).includes('MOCK052_SECRET'));
 const g=calls.filter(x=>JSON.parse(x.messages[1].content).outputContract);assert.equal(g.length,2);const repair=JSON.parse(g[1].messages[1].content).repair;assert.equal(repair.evidence,undefined);assert.equal(repair.frame.context,undefined);assert.ok(repair.diagnostics.issues.some(x=>x.path==='/actionFrame'));
 }finally{child.kill();if(child.exitCode===null)await Promise.race([once(child,'exit'),sleep(1500)]);upstream.closeAllConnections();await new Promise(r=>upstream.close(r));fs.rmSync(dir,{recursive:true,force:true});}
});
