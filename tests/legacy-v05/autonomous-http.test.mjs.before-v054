import test from 'node:test';import assert from 'node:assert/strict';import http from 'node:http';import fs from 'node:fs';import os from 'node:os';import path from 'node:path';import {execFile} from 'node:child_process';import {promisify} from 'node:util';
import {ExperimentManager,LabRun} from '../dist/src/lab/manager.js';import {parseConfig} from '../dist/src/lab/types.js';import {createLabHandler} from '../server/lab/http.mjs';
import {tiny,backend,generator,proposal,chooseDeposit} from './fixtures/adaptive-v05.mjs';
const exec=promisify(execFile),actor={id:'agent:v05-test',kind:'agent',label:'Offline synthetic test'},sleep=ms=>new Promise(r=>setTimeout(r,ms));
async function fixture(t,{select=chooseDeposit,generate=()=>proposal()}={}){
 const b=backend(select),g=generator(generate),providers={ready:()=>true,backend:()=>b,adapt:g.propose.bind(g),adaptSource:{id:g.id,kind:'mock'}};
 const m=new ExperimentManager(providers),token='local-test-token',dir=fs.mkdtempSync(path.join(os.tmpdir(),'gs-v05-'));let handler;
 const server=http.createServer(async(req,res)=>{if(req.url==='/api/status'){res.writeHead(200,{'content-type':'application/json'});res.end(JSON.stringify({token,jevReady:true,llmReady:true}));return;}if(!await handler(req,res,new URL(req.url,'http://localhost'))){res.writeHead(404);res.end();}});
 await new Promise(r=>server.listen(0,'127.0.0.1',r));const base=`http://127.0.0.1:${server.address().port}`;handler=createLabHandler({manager:m,token,baseUrl:base,archiveDir:dir});
 t.after(async()=>{m.close();server.closeAllConnections();await new Promise(r=>server.close(r));fs.rmSync(dir,{recursive:true,force:true});});
 const api=async(p,body)=>{const r=await fetch(base+p,{method:body?'POST':'GET',headers:{'content-type':'application/json','x-gs-token':token},...(body?{body:JSON.stringify(body)}:{})});return {status:r.status,data:await r.json()};};
 const add=(config={})=>{const r=new LabRun(parseConfig({kind:'game',controller:'adaptive',backend:'jev',generator:'llm',allowLive:true,maxRequests:30,...config}),actor,providers,tiny());m.runs.set(r.runId,r);return r;};
 const cmd=(r,action,extra={})=>api(`/api/lab/runs/${r.runId}/commands`,{commandId:crypto.randomUUID(),actor,action,expectedControlVersion:r.controlVersion,...extra});
 return {m,b,g,base,token,api,add,cmd,dir};
}
test('v05 HTTP/CLI use same run while startup G precedes meta and action S',async t=>{const f=await fixture(t),r=f.add();const out=await exec(process.execPath,['bin/gs-lab.mjs','step',r.runId,'--url',f.base,'--actor',actor.id],{cwd:process.cwd()});const receipt=JSON.parse(out.stdout);const read=(await f.api('/api/lab/runs/'+r.runId)).data;assert.equal(receipt.state.runId,read.runId);assert.equal(read.status,'succeeded');assert.equal(read.diagnostics.gCalls,1);assert.equal(read.physicalActions,1);assert.equal(read.externalRequests,0);assert.deepEqual(receipt.state.world,read.world);});
test('v05 shared observer sees G-in-flight without creating another engine',async t=>{let release,entered;const gate=new Promise(r=>entered=r),pending=new Promise(r=>release=r);const f=await fixture(t,{generate:async()=>{entered();await pending;return proposal();}}),r=f.add();const p=f.cmd(r,'step');await gate;const s=(await f.api('/api/lab/runs/'+r.runId)).data;assert.equal(s.diagnostics.phase,'initializing');assert.equal(s.busy,true);assert.equal(s.world.turn,0);assert.ok(r.events.some(e=>e.type==='state'&&e.data.diagnostics?.phase==='initializing'));release();await p;assert.equal(r.status,'succeeded');});
test('v05 cancellation while G works aborts whole recursive computation, no late action',async t=>{let entered;const gate=new Promise(r=>entered=r);const f=await fixture(t,{generate:async()=>{entered();await sleep(150);return proposal();}}),r=f.add();const p=f.cmd(r,'step');await gate;await f.cmd(r,'cancel');await p;await sleep(180);assert.equal(r.status,'cancelled');assert.equal(r.view().physicalActions,0);assert.equal(r.view().diagnostics.adaptations.length,0);});
test('v05 idempotent command replay does not ask G twice',async t=>{const f=await fixture(t),r=f.add(),body={commandId:'same',actor,action:'step',expectedControlVersion:0},url='/api/lab/runs/'+r.runId+'/commands';await f.api(url,body);const again=await f.api(url,body);assert.equal(again.data.replayed,true);assert.equal(f.g.calls.length,1);assert.equal(r.view().physicalActions,1);});
test('v05 no-authority observer gets 409, cannot steer partial S',async t=>{const f=await fixture(t),r=f.add();const x=await f.cmd(r,'step',{actor:{id:'human:observer',kind:'human',label:'observer'}});assert.equal(x.status,409);assert.equal(r.view().requests,0);});
test('v05 archived export contains S packet, G alternatives and patch decision; no secrets',async t=>{const f=await fixture(t),r=f.add();await f.cmd(r,'step');const ex=(await f.api('/api/lab/runs/'+r.runId+'/export')).data;assert.equal(ex.trace.informationPolicy,'no-reference/v05');assert.ok(ex.trace.requests.some(r=>r.role==='G'&&r.input.answer===null&&r.input.cause==='initial_environment_review'));assert.ok(ex.trace.requests.some(r=>r.role==='S'&&r.depth===1));assert.ok(!JSON.stringify(ex).includes(f.token));assert.ok(ex.trace.events.some(e=>e.type==='adaptation_committed'));});
test('v05 G/S root request budget counts meta selection as well as physical selection',async t=>{const f=await fixture(t),r=f.add({maxRequests:2});await f.cmd(r,'step');assert.equal(r.view().requests,2);assert.equal(r.view().physicalActions,0);assert.match(r.reason,/budget/);});
test('v05 recursive meta rejection remains finite on server',async t=>{const f=await fixture(t,{select:()=>null,generate:i=>i.frame.kind==='action'?proposal():{proposals:[{kind:'reframe',question:'compare constraints',hypothesis:'fixture hypothesis',ruleIds:[],includeBroaderObservation:true,candidateIds:null}]}}),r=f.add({maxDepth:2});await f.cmd(r,'step');assert.equal(r.status,'blocked');assert.equal(r.reason,'adaptation_depth_exhausted');assert.equal(r.view().diagnostics.gCalls,2);assert.equal(r.view().physicalActions,0);});
test('v05 live-labelled configuration with mock providers remains clearly mock in evidence',async t=>{const f=await fixture(t),r=f.add();await f.cmd(r,'step');assert.equal(r.view().externalRequests,0);assert.equal(r.view().lastDecision.source,'mock');assert.equal(r.view().diagnostics.provenance.source,'mock');});
test('v05 API rejects reference and solution injection before any G request',async t=>{const f=await fixture(t);const bad=await f.api('/api/lab/runs',{requestId:'injected',actor,config:{kind:'game',controller:'adaptive',referenceSolution:['drop']}});assert.equal(bad.status,400);assert.equal(f.g.calls.length,0);});
test('v05 status event sequence remains unique during nested reasoning',async t=>{const f=await fixture(t),r=f.add();await f.cmd(r,'step');const events=(await f.api(`/api/lab/runs/${r.runId}/events?after=0&limit=1000`)).data.events;assert.ok(events.every((e,i)=>e.seq===i+1&&e.runId===r.runId));const last=events.at(-1);assert.equal(last.data.lastSeq,last.seq);});
