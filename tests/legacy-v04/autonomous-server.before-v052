/** Network transport runs only against a loopback fake provider. */
import test from 'node:test';import assert from 'node:assert/strict';import http from 'node:http';import {spawn} from 'node:child_process';import {once} from 'node:events';import fs from 'node:fs';import os from 'node:os';import path from 'node:path';
import {proposal} from './fixtures/adaptive-v05.mjs';
let child,mock,base,token,dir;const calls=[],secret='LOCAL_TEST_KEY_ONLY';
const sleep=ms=>new Promise(r=>setTimeout(r,ms));
async function free(){const s=http.createServer();s.listen(0,'127.0.0.1');await once(s,'listening');const p=s.address().port;await new Promise(r=>s.close(r));return p;}
async function request(p,body,headers={}){const r=await fetch(base+p,{method:body?'POST':'GET',headers:{'x-gs-token':token,'content-type':'application/json',...headers},...(body?{body:JSON.stringify(body)}:{})});return {status:r.status,text:await r.text()};}
test.before(async()=>{dir=fs.mkdtempSync(path.join(os.tmpdir(),'gs-real-wire-'));
 mock=http.createServer(async(req,res)=>{const chunks=[];for await(const c of req)chunks.push(c);const body=JSON.parse(Buffer.concat(chunks));calls.push(body);assert.equal(req.headers.authorization,'Bearer '+secret);const g=body.messages[0].content.startsWith('You are G');let output;
 if(g){output=proposal();}else{const data=JSON.parse(body.messages[1].content),answers={};for(const [id,q]of Object.entries(data.questions)){if(q.type==='choice')answers[id]={type:'choice',choice:'none',confidence:1,probabilities:Object.fromEntries(Object.keys(q.criteria).map(k=>[k,k==='none'?1:0]))};else if(q.type==='noul')answers[id]={type:'noul',noul:0};else answers[id]={type:'score',score:0};}output={answers};}
 res.writeHead(200,{'content-type':'application/json'});res.end(JSON.stringify({model:'local-wire-test-fixture',choices:[{message:{content:JSON.stringify(output)}}],usage:{prompt_tokens:10,completion_tokens:5}}));});
 mock.listen(0,'127.0.0.1');await once(mock,'listening');const port=await free();base=`http://127.0.0.1:${port}`;
 child=spawn(process.execPath,['server.mjs'],{cwd:process.cwd(),env:{...process.env,PORT:String(port),TYPESAFE_API_KEY:'',LLM_API_KEY:secret,LLM_MODEL:'local-wire-test-fixture',LLM_URL:`http://127.0.0.1:${mock.address().port}/chat`,GS_LAB_OUTPUT_DIR:dir,MAX_SERVER_CALLS:'3'},stdio:['ignore','pipe','pipe']});
 for(let i=0;i<100;i++){try{const r=await fetch(base+'/api/status');if(r.ok){token=(await r.json()).token;return;}}catch{}await sleep(30);}throw Error('server start failed');
});
test.after(async()=>{child?.kill();if(child&&child.exitCode===null)await Promise.race([once(child,'exit'),sleep(2000)]);mock?.closeAllConnections();if(mock)await new Promise(r=>mock.close(r));fs.rmSync(dir,{recursive:true,force:true});});
test('v05 static assets keep browser security and current UI version',async()=>{const r=await fetch(base+'/lab');assert.equal(r.status,200);assert.match(r.headers.get('content-security-policy'),/frame-ancestors 'none'/);assert.match(await r.text(),/lab.js/);assert.match((await request('/lab.js')).text,/v0.5.1/);});
test('v05 status exposes readiness not credentials',async()=>{const r=await request('/api/status');assert.ok(!r.text.includes(secret));assert.equal(JSON.parse(r.text).version,'0.5.1');assert.equal(JSON.parse(r.text).legacyLive,false);});
test('v05 server cannot serve code, environment or benchmark reports',async()=>{for(const p of ['/.env','/server.mjs','/package.json','/reports/benchmark-v04.json','/tests/fixtures/adaptive-v05.mjs'])assert.equal((await request(p)).status,404);});
test('v05 all old solved-skill live endpoints return 410 without provider access',async()=>{const n=calls.length;for(const p of ['/api/select','/api/plan','/api/program','/api/reactive-select','/api/reactive-plan']){const r=await request(p,{});assert.equal(r.status,410);assert.match(r.text,/LEGACY_ASSISTANCE_FORBIDDEN/);}assert.equal(calls.length,n);});
test('v05 host/origin/token checks remain enforced',async()=>{const h=await new Promise((resolve,reject)=>http.get(base+'/api/status',{headers:{host:'evil.example'}},r=>{r.resume();resolve(r.statusCode);}).on('error',reject));assert.equal(h,403);assert.equal((await request('/api/judgment',{}, {origin:'https://evil.example'})).status,403);assert.equal((await request('/api/lab/capabilities',undefined,{'x-gs-token':'wrong'})).status,401);});
test('v05 true HTTP path can route S -> G -> meta S without any reference helper',async()=>{const actor={id:'agent:wire',kind:'agent',label:'Local provider mock'},r=JSON.parse((await request('/api/lab/runs',{requestId:'wire',actor,config:{kind:'game',controller:'adaptive',backend:'llm',generator:'llm',allowLive:true,maxRequests:20,maxGCalls:2,deadlineMs:10000}})).text);
 const result=await request(`/api/lab/runs/${r.runId}/commands`,{commandId:'one',actor,action:'step',expectedControlVersion:0});assert.equal(result.status,200);const v=JSON.parse(result.text).state;assert.equal(v.physicalActions,0);assert.ok(calls.some(c=>c.messages[0].content.startsWith('You are G')));assert.equal(calls.length,3);assert.ok(/budget|HTTP 429/.test(v.reason));
 const g=calls.find(c=>c.messages[0].content.startsWith('You are G'));const data=JSON.parse(g.messages[1].content);assert.ok(!data.example);assert.equal(data.request.answer.choice,null);assert.ok(!JSON.stringify(g).includes('place-resource'));assert.ok(!JSON.stringify(g).includes(secret));
 const ex=JSON.parse((await request(`/api/lab/runs/${r.runId}/export`)).text);assert.ok(ex.events.some(e=>e.type==='engine'&&e.data.event.type==='provider_transport'));assert.ok(!JSON.stringify(ex).includes(secret));
});
