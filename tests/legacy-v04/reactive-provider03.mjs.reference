import test from 'node:test';import assert from 'node:assert/strict';import {reactiveRequest} from '../server/reactive.mjs';
import {makeSkill} from '../dist/src/skills/spec.js';import {createWorld} from '../dist/src/game/world.js';
const spec=makeSkill('access-open',['place-resource','wait-access'],'llm'),initial=createWorld('guarded');
const env={TYPESAFE_API_KEY:'fixture-secret',JEV_MODEL:'jev-fixture',LLM_API_KEY:'fixture-secret',LLM_MODEL:'fixture-model',LLM_URL:'http://127.0.0.1:9999/chat'};
const input={state:initial,binding:{targetId:initial.guards[0].id,targetBerryIds:initial.berries.map(b=>b.id),amount:0}};
const result=x=>new Response(JSON.stringify({model:'mock-v03',usage:{prompt_tokens:7,completion_tokens:13},choices:[{message:{content:JSON.stringify(x)}}]}),{status:200});
test('v03 LLM adapter validates skill JSON and keeps actual mock usage',async()=>{let calls=0;const a=await reactiveRequest('reactive-plan',input,{env,signal:new AbortController().signal,charge:()=>calls++,fetcher:async()=>result(spec)});assert.equal(calls,1);assert.equal(a.output.schema,'gs/skill/v1');assert.equal(a.usage.inputTokens,7);});
test('v03 rejected LLM skill returns feedback plus provider usage',async()=>{await assert.rejects(reactiveRequest('reactive-plan',input,{env,signal:new AbortController().signal,charge:()=>{},fetcher:async()=>result({...spec,eval:'true'})}),e=>e.status===422&&e.rejection.stage==='skill-schema'&&e.usage.outputTokens===13);});
test('v03 repair evidence forwarded into LLM input',async()=>{let body;await reactiveRequest('reactive-plan',{...input,feedback:{reason:'failed local goal'}},{env,signal:new AbortController().signal,charge:()=>{},fetcher:async(_u,o)=>{body=JSON.parse(o.body);return result(spec);}});assert.equal(JSON.parse(body.messages[1].content).validationFeedback.reason,'failed local goal');assert(!body.messages[1].content.includes('fixture-secret'));});
test('v03 provider error is not silently replaced by local search',async()=>{let calls=0;await assert.rejects(reactiveRequest('reactive-plan',input,{env,signal:new AbortController().signal,charge:()=>calls++,fetcher:async()=>new Response('fail',{status:503})}),/LLM HTTP/);assert.equal(calls,1);});
test('v03 unsafe HTTP provider URL rejected before call',async()=>{let calls=0;await assert.rejects(reactiveRequest('reactive-plan',input,{env:{...env,LLM_URL:'http://example.com/chat'},signal:new AbortController().signal,charge:()=>calls++,fetcher:async()=>result(spec)}),/HTTPS/);assert.equal(calls,0);});
test('v03 Jev bridge sends one independent Choice and candidate Noul per option',async()=>{let sent,calls=0;
 const query={level:'child',goal:'acquired-one',projection:{resources:{bag:0,energy:30}},candidates:[{id:'wait',description:'Wait safely',action:{kind:'wait'}},{id:'pickup:a',description:'Pick up the target berry',action:{kind:'pickup',berryId:'a'}}]};
 const answer=await reactiveRequest('reactive-select',query,{env,signal:new AbortController().signal,charge:()=>calls++,fetcher:async(url,o)=>{assert.equal(url,'https://api.typesafe.ai/v1/systemone');sent=JSON.parse(o.body);return new Response(JSON.stringify({model:'mock-jev',usage:{input_tokens:10,output_tokens:0},answers:{next:{type:'choice',choice:'a1',confidence:.9,probabilities:{none:.01,a0:.04,a1:.95}},fit_a0:{type:'noul',noul:.5},fit_a1:{type:'noul',noul:.9}}}));}});
 assert.equal(calls,1);assert.equal(answer.output.choice,'pickup:a');assert.equal(Object.keys(sent.questions).length,3);assert.deepEqual(sent.state.features,query.projection);assert(!JSON.stringify(sent.state).includes('fixture-secret'));
});
test('v03 invalid candidate types rejected before any model calls',async()=>{let n=0;await assert.rejects(reactiveRequest('reactive-select',{level:'child',goal:'x',projection:{},candidates:[{id:'x',description:'x',action:{kind:'eval'}}]},{env,signal:new AbortController().signal,charge:()=>n++,fetcher:async()=>{throw Error('should not execute')}}));assert.equal(n,0);});
test('v03 selector option aliases remain bounded by supplied candidates',async()=>{await assert.rejects(reactiveRequest('reactive-select',{level:'child',goal:'x',projection:{},candidates:[{id:'x',description:'x',action:{kind:'wait'}}]},{env,signal:new AbortController().signal,charge:()=>{},fetcher:async()=>new Response(JSON.stringify({answers:{next:{type:'choice',choice:'evil',probabilities:{none:0,a0:1}}}}))}),/unknown Jev/);});
