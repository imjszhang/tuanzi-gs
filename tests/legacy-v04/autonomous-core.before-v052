import test from 'node:test';import assert from 'node:assert/strict';
import {AutonomousSession} from '../dist/src/adaptive/session.js';
import {parsePatches,parseProgram,OUTPUT_SPEC} from '../dist/src/adaptive/spec.js';
import {publicWorld,legalActions,PUBLIC_RULES,actionId} from '../dist/src/adaptive/world-port.js';
import {AdaptiveGS,InvalidAdaptation} from '../dist/vendor/gs-engine-ts/src/adaptive.js';
import {tiny,program,proposal,generator,backend,chooseDeposit} from './fixtures/adaptive-v05.mjs';
const run=(s,g,extra={},state=tiny())=>new AutonomousSession(state,{backend:s,generator:g,strategy:'direct',orderSeed:441,...extra});
const keys=Object.keys(PUBLIC_RULES);
test('v05 first S abstention is repaired in the SAME run, not blocked or forced',async()=>{const b=backend((f,n)=>n===1?null:chooseDeposit(f)),g=generator(),s=run(b,g);await s.step();assert.equal(s.lastResult.outcome,'succeeded');assert.equal(s.world.snapshot().turn,1);assert.equal(g.calls.length,1);assert.equal(g.calls[0].answer.choice,null);assert.equal(g.calls[0].frame.kind,'action');assert.equal(s.diagnostics().metaCalls,1);assert.ok(s.events.some(e=>e.type==='adaptation_committed'));});
test('v05 exactly recorded S context/options/output are passed to G',async()=>{const b=backend((f,n)=>n===1?null:chooseDeposit(f)),g=generator(),s=run(b,g);await s.step();const r=g.calls[0];assert.deepEqual(r.frame,b.calls[0].state.evidence.frame);assert.equal(r.answer.detail.answers.choose.choice,'none');assert.equal(r.evidence.observedWorld.energy,80);assert.equal(r.evidence.measuredHistory.length,0);});
test('v05 G can add broader observations while initial S remains incomplete',async()=>{const b=backend((f,n)=>n===1?null:chooseDeposit(f)),g=generator(),s=run(b,g);await s.step();assert.ok(!b.calls[0].state.evidence.frame.context.observation.objects);assert.ok(g.calls[0].evidence.observedWorld.terrain);assert.ok(b.calls.at(-1).state.evidence.frame.context.observation.objects);});
test('v05 root changes stay hypotheses, not authoritative facts',async()=>{const g=generator(()=>proposal(program('执行当前阶段',['deposit'],{hypothesis:'我猜这个动作可推进任务'}))),s=run(backend((f,n)=>n===1?null:chooseDeposit(f)),g);await s.step();const commit=s.events.find(e=>e.type==='adaptation_committed'&&e.data.depth===0);assert.equal(commit.data.after.context.gHypothesis.status,'unverified-generator-hypothesis');assert.equal(s.world.snapshot().target,5);});
test('v05 wrong confident waiting triggers G from ACTUAL feedback, without oracle comparison',async()=>{const b=backend(f=>f.kind==='reframe'?f.options[0].id:f.context.localObjective.includes('完成')?chooseDeposit(f):'wait'),g=generator(),s=run(b,g);for(let i=0;i<7&&!s.finished;i++)await s.step();assert.equal(s.lastResult.outcome,'succeeded');assert.ok(g.calls[0].cause.includes('cycle'));assert.equal(g.calls[0].evidence.measuredHistory.length,6);assert.equal(g.calls[0].evidence.previousIssue.referenceCompared,false);});
test('v05 meta failure recursively invokes G at next scale and returns to action',async()=>{const b=backend(f=>{if(f.kind==='action')return f.question.includes('完成')?chooseDeposit(f):null;return f.question==='元判断已重新聚焦'||f.context.lowerFrame?.kind==='reframe'?f.options[0].id:null;});const g=generator(input=>input.frame.kind==='action'?proposal():{proposals:[{kind:'reframe',question:'元判断已重新聚焦',hypothesis:'核验上下文修订，不决定物理动作',ruleIds:['goal'],includeBroaderObservation:true,candidateIds:null}]});const s=run(b,g);await s.step();assert.equal(s.lastResult.outcome,'succeeded');assert.ok(g.calls.some(x=>x.depth===1));assert.ok(s.events.some(e=>e.type==='meta_enter'&&e.data.depth===2));assert.ok(s.events.some(e=>e.type==='adaptation_committed'&&e.data.depth===1));});
test('v05 persistent abstention has finite depth and never executes second probability choice',async()=>{const s=run(backend(()=>null),generator(i=>i.frame.kind==='action'?proposal():{proposals:[{kind:'reframe',question:'重新理解比较范围',hypothesis:'仅测试',ruleIds:[],includeBroaderObservation:true,candidateIds:null}]}));await s.step();assert.equal(s.lastResult.kind,'paused');assert.equal(s.lastResult.reason,'adaptation_depth_exhausted');assert.equal(s.world.snapshot().turn,0);assert.equal(s.diagnostics().gCalls,2);});
test('v05 renaming program does not count as new decision conditions',async()=>{const b=backend(f=>f.kind==='reframe'?f.options[0].id:null);const g=generator((i,n)=>{const p=program();p.title='renamed-'+n;return proposal(p);});const s=run(b,g,{maxDepth:1,maxRevisions:3});await s.step();assert.equal(s.world.snapshot().turn,0);assert.ok(s.events.some(e=>e.type==='adaptation_rejected'&&e.data.reason==='duplicate_decision_no_change'));});
test('v05 same external state may legitimately get new context and candidates',async()=>{const b=backend(f=>f.kind==='reframe'?f.options[0].id:f.question==='新局部范围'?chooseDeposit(f):null),g=generator(()=>proposal(program('新局部范围',['deposit']))),s=run(b,g);await s.step();assert.equal(s.lastResult.outcome,'succeeded');assert.equal(s.events.find(e=>e.type==='adaptation_committed').data.before.revision,s.events.find(e=>e.type==='adaptation_committed').data.after.revision);});
test('v05 invalid proposal feeds STRUCTURAL error into later G attempt',async()=>{const g=generator((i,n)=>n===1?{proposals:[{kind:'program',program:program(),forceSuccess:true}]}:proposal()),s=run(backend((f,n)=>n===1?null:chooseDeposit(f)),g);await s.step();assert.equal(s.lastResult.outcome,'succeeded');assert.equal(g.calls.length,2);assert.ok(g.calls[1].previous[0].reason.includes('unsupported_field'));});
test('v05 no substitution when G makes all offered actions disappear',async()=>{const g=generator(()=>proposal(program('测试不可用候选',['deposit'],{candidateIds:['move:999,999']}))),s=run(backend(f=>f.kind==='reframe'?f.options[0].id:null),g,{maxRevisions:2});await s.step();assert.equal(s.world.snapshot().turn,0);assert.equal(s.finished,true);});
test('v05 world change during S discards result and preserves edit',async()=>{let session;const b=backend(async f=>{session.world.edit('wall',{x:0,y:0});return chooseDeposit(f);});session=run(b,generator());const r=await session.step();assert.equal(r.kind,'stale');assert.equal(session.world.snapshot().turn,0);assert.equal(session.world.snapshot().walls.length,1);});
test('v05 world change during G cannot commit a stale reframe',async()=>{let session;const g=generator(()=>{session.world.edit('wall',{x:0,y:0});return proposal();});session=run(backend(()=>null),g);await session.step();assert.equal(session.lastResult.kind,'stale');assert.equal(session.events.filter(e=>e.type==='adaptation_committed').length,0);});
test('v05 cancellation across meta processing never writes world',async()=>{let entered;const gate=new Promise(r=>entered=r);const b=backend(async f=>{if(f.kind==='reframe'){entered();await new Promise(r=>setTimeout(r,100));}return f.kind==='action'?null:f.options[0].id;});const s=run(b,generator());const pending=s.step();await gate;s.cancel();await pending;await new Promise(r=>setTimeout(r,130));assert.equal(s.world.snapshot().turn,0);assert.equal(s.lastResult.kind,'stopped');});
test('v05 root G budget persists across all recursive frames',async()=>{const s=run(backend(()=>null),generator(),{maxGCalls:1});await s.step();assert.equal(s.diagnostics().gCalls,1);assert.equal(s.world.snapshot().turn,0);});
test('v05 raw hints / reference fields in world are never copied to G',async()=>{const w=tiny();w.lastFact='SECRET_OPTIMAL_ROUTE';w.scenario='SECRET_SOLUTION';w.referenceSolution='SECRET_CANARY';const g=generator(),s=run(backend((f,n)=>n===1?null:chooseDeposit(f)),g,{},w);await s.step();assert.ok(!JSON.stringify(g.calls).includes('SECRET_'));assert.ok(!JSON.stringify(publicWorld(w)).includes('SECRET_'));});
test('v05 base candidate set includes all legal primitives without phase solution gating',()=>{const w=tiny(),cs=legalActions(w).map(actionId);assert.ok(cs.includes('eat'));assert.ok(cs.includes('deposit:1'));assert.ok(cs.some(x=>x.startsWith('drop:')));assert.ok(cs.includes('wait'));});
test('v05 G cannot invent a tool or claim root success in schema',()=>{const p=program();p.stages[0].kinds=['teleport'];assert.throws(()=>parseProgram(p,keys));assert.throws(()=>parsePatches({proposals:[{kind:'program',program:program(),rootGoal:'changed'}]},'action',keys));});
test('v05 executable predicates are finite and registered, never arbitrary code',()=>{const p=program();p.stages[0].until=[{kind:'eval',code:'return true'}];assert.throws(()=>parseProgram(p,keys));assert.ok(!JSON.stringify(OUTPUT_SPEC).includes('place-resource'));});
test('v05 simulation/reference memory cannot seed autonomous memory',()=>{assert.throws(()=>run(backend(chooseDeposit),generator(),{memory:{schema:'gs/reactive-catalogue/v1',records:[]}}));});
test('v05 single offered option still passes through S with none available',async()=>{const s=run(backend(f=>f.kind==='reframe'?f.options[0].id:f.question.includes('完成')?null:null),generator(()=>proposal(program('完成局部任务',['deposit']))),{maxRevisions:1});await s.step();assert.equal(s.world.snapshot().turn,0);assert.ok(s.decisions.some(x=>x.packet.candidates.length===1&&x.status==='abstained'));});
for(const strategy of ['direct','batch','serial','dependent'])test(`v05 ${strategy} action and meta use actual judgment scheduler`,async()=>{const s=run(backend(chooseDeposit),generator(),{strategy});await s.step();assert.equal(s.lastResult.outcome,'succeeded');assert.ok(s.events.some(e=>e.type==='judgment_run'&&e.data.questionStrategy===strategy));});
test('v05 no generation when initial S can act',async()=>{const g=generator(),s=run(backend(chooseDeposit),g);await s.step();assert.equal(g.calls.length,0);assert.equal(s.world.snapshot().delivered,5);});
test('v05 aborted action cannot add success evidence',async()=>{const s=run(backend(()=>null),generator(),{experience:'use'});s.cancel();await s.step();assert.equal(s.memory().records.filter(r=>r.status==='root-succeeded').length,0);});
test('v05 two simultaneous step calls cannot write twice',async()=>{const s=run(backend(async f=>{await new Promise(r=>setTimeout(r,15));return chooseDeposit(f);}),generator());const a=s.step();await assert.rejects(s.step(),/concurrent/);await a;assert.equal(s.world.snapshot().turn,1);});
test('v05 stage completion is local and does not declare root success',async()=>{const p=program('先食用一颗',['eat'],{until:[{kind:'delta',field:'eaten',atLeast:1}]});let n=0;const g=generator(()=>proposal(n++?program():p)),b=backend(f=>f.kind==='reframe'?f.options[0].id:f.question==='先食用一颗'?'eat':f.question.includes('完成')?chooseDeposit(f):null);const w=tiny();w.bag=2;const s=run(b,g,{},w);await s.step();assert.equal(s.finished,false);assert.equal(s.world.snapshot().delivered,4);await s.step();assert.equal(s.lastResult.outcome,'succeeded');assert.ok(s.events.some(e=>e.type==='local_goal_completed'&&e.data.rootSucceeded===false));});
test('v05 legal capability set unchanged from environment baseline, not solution ranking',async()=>{
 const {legalPrimitives}=await import('../dist/src/planning/search.js');
 const {createWorld}=await import('../dist/src/game/world.js');
 for(const scenario of ['meadow','guarded','remix','detour'])for(const bag of [0,1,3])for(const energy of [0,80,100]){
  const w=createWorld(scenario);w.bag=bag;w.energy=energy;
  assert.deepEqual(legalActions(w).map(actionId).sort(),legalPrimitives(w).map(actionId).sort());
 }
});
test('v05 actual wrong-choice context and output accompany feedback-based G review',async()=>{
 const b=backend(f=>f.kind==='reframe'?f.options[0].id:f.question.includes('完成')?chooseDeposit(f):'wait'),g=generator(),s=run(b,g);
 for(let i=0;i<7&&!s.finished;i++)await s.step();
 assert.equal(g.calls[0].evidence.selectorHistory.length,3);
 assert.equal(g.calls[0].evidence.selectorHistory.at(-1).judgment.choice,'wait');
 assert.ok(g.calls[0].evidence.selectorHistory[0].packet.projection);
});
test('v05 actual injury triggers G without assuming S reports uncertainty',async()=>{
 const w=tiny();w.player={x:3,y:5};w.guards=[{id:'g',x:5,y:5,anchor:{x:4,y:5},eating:0}];
 const b=backend(f=>f.kind==='reframe'?f.options[0].id:'wait'),g=generator(),s=run(b,g,{maxRevisions:1},w);
 await s.step();assert.equal(s.history[0].delta.attacks,1);await s.step();assert.equal(g.calls[0].cause,'unexpected_damage');assert.equal(g.calls[0].evidence.previousIssue.referenceCompared,false);assert.equal(g.calls[0].evidence.selectorHistory.at(-1).choice,'wait');
});

test('v05 same stage with a reset action counter is not a novel repair',async()=>{
 const p=program('保持当前测试阶段',['wait'],{until:[{kind:'delta',field:'delivered',atLeast:1}],maxActions:30});
 const b=backend(f=>f.kind==='reframe'?f.options[0].id:f.question===p.stages[0].question?'wait':null),g=generator(()=>proposal(p));
 const s=run(b,g,{maxGCalls:4,maxRevisions:2});
 for(let i=0;i<7&&!s.finished;i++)await s.step();
 assert.equal(s.events.filter(e=>e.type==='adaptation_committed'&&e.data.depth===0).length,1);
 assert.ok(s.events.some(e=>e.type==='adaptation_rejected'&&e.data.reason==='duplicate_decision_no_change'));
 assert.equal(s.world.snapshot().turn,6);
});

test('v05 generic AdaptiveGS is available through public engine entry point',async()=>{const m=await import('../dist/vendor/gs-engine-ts/src/index.js');assert.equal(m.AdaptiveGS,AdaptiveGS);});
