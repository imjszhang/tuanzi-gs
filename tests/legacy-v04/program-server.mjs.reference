import test from 'node:test';
import assert from 'node:assert/strict';
import http from 'node:http';
import {spawn} from 'node:child_process';
import {once} from 'node:events';
import {fileURLToPath} from 'node:url';
import {createWorld} from '../dist/src/game/world.js';
import {INITIAL_POLICY,GOAL,CAPABILITIES} from '../dist/src/game/types.js';
import {searchProgram} from '../dist/src/planning/search.js';
import {verifyProgram} from '../dist/src/planning/programs.js';
const root=fileURLToPath(new URL('..',import.meta.url));
let child,mock,base,token,answer,mockCalls=0,lastRequest;
const state=createWorld('guarded');
const payload=()=>({context:{goal:GOAL,snapshot:{revision:'1',observedAt:0,state},policy:{...INITIAL_POLICY,body:{...INITIAL_POLICY.body,mode:'program',enabled:[...CAPABILITIES]}},recent:[]},reason:'no_suitable_candidate'});
const headers=()=>({'content-type':'application/json',origin:base,'x-gs-token':token});
test.before(async()=>{
  const solved=await searchProgram(state,new AbortController().signal,{heuristic:'explore'});answer={title:'本地模拟返回的程序，非真实模型',actions:solved.actions};
  mock=http.createServer(async(req,res)=>{mockCalls++;const bufs=[];for await(const b of req)bufs.push(b);lastRequest=JSON.parse(Buffer.concat(bufs));res.writeHead(200,{'content-type':'application/json'});res.end(JSON.stringify({model:'mock-program-provider',choices:[{message:{content:JSON.stringify(answer)}}],usage:{prompt_tokens:250,completion_tokens:850}}));});
  mock.listen(0,'127.0.0.1');await once(mock,'listening');const reserve=http.createServer();reserve.listen(0,'127.0.0.1');await once(reserve,'listening');const port=reserve.address().port;await new Promise(r=>reserve.close(r));base=`http://127.0.0.1:${port}`;
  child=spawn(process.execPath,['server.mjs'],{cwd:root,env:{...process.env,PORT:String(port),TYPESAFE_API_KEY:'',LLM_API_KEY:'LOCAL_TEST_ONLY',LLM_MODEL:'mock-program-provider',LLM_URL:`http://127.0.0.1:${mock.address().port}/chat/completions`,MAX_SERVER_CALLS:'4'},stdio:'ignore'});
  for(let i=0;i<80;i++){try{const r=await fetch(base+'/api/status');if(r.ok){token=(await r.json()).token;return;}}catch{}await new Promise(r=>setTimeout(r,30));}throw new Error('server did not start');
});
test.after(async()=>{child?.kill();if(mock)await new Promise(r=>mock.close(r));});
test('program generation endpoint requires local origin/token before spending',async()=>{const r=await fetch(base+'/api/program',{method:'POST',headers:{...headers(),'x-gs-token':'wrong'},body:JSON.stringify(payload())});assert.equal(r.status,403);assert.equal(mockCalls,0);});
test('LLM raw primitive proposal is compiled and independently simulated by the server',async()=>{const r=await fetch(base+'/api/program',{method:'POST',headers:headers(),body:JSON.stringify(payload())});assert.equal(r.status,200);const a=await r.json();assert.equal(a.output.body.mode,'program');assert.equal(a.output.baseVersion,1);assert.equal(a.output.basedOnRevision,'1');assert.equal(verifyProgram(state,a.output.body.program).ok,true);assert.equal(a.usage.inputTokens,250);assert.equal(a.usage.outputTokens,850);assert.ok(lastRequest.messages[0].content.includes('No code'));assert.equal(mockCalls,1);});
test('LLM root-goal override is rejected, not converted into a preset',async()=>{answer={title:'bad',actions:[{kind:'wait'}],goal:'deliver zero'};const r=await fetch(base+'/api/program',{method:'POST',headers:headers(),body:JSON.stringify(payload())});assert.equal(r.status,502);assert.match((await r.json()).error,/unauthorized/);assert.equal(mockCalls,2);});
test('LLM program containing teleportation is rejected without silent fallback',async()=>{answer={title:'bad',actions:[{kind:'move',x:16,y:10}]};const r=await fetch(base+'/api/program',{method:'POST',headers:headers(),body:JSON.stringify(payload())});assert.equal(r.status,502);assert.match((await r.json()).error,/illegal/);assert.equal(mockCalls,3);});
test('LLM surviving but incomplete program is rejected by root verifier',async()=>{answer={title:'bad',actions:[{kind:'wait'}]};const r=await fetch(base+'/api/program',{method:'POST',headers:headers(),body:JSON.stringify(payload())});assert.equal(r.status,502);assert.match((await r.json()).error,/root_goal/);assert.equal(mockCalls,4);});
test('invalid provider responses still consume the shared server request budget',async()=>{const r=await fetch(base+'/api/program',{method:'POST',headers:headers(),body:JSON.stringify(payload())});assert.equal(r.status,429);assert.equal(mockCalls,4);});
