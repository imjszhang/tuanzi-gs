import test from 'node:test';import assert from 'node:assert/strict';import http from 'node:http';import {spawn} from 'node:child_process';import {once} from 'node:events';import {fileURLToPath} from 'node:url';
import {createWorld} from '../dist/src/game/world.js';import {INITIAL_POLICY,GOAL,CAPABILITIES} from '../dist/src/game/types.js';
let child,mock,base,token,calls=0,request;
const state=createWorld('meadow');state.player={...state.home};state.delivered=4;state.bag=3;state.energy=10;
const context={goal:GOAL,snapshot:{revision:'1',state},policy:{...INITIAL_POLICY,body:{...INITIAL_POLICY.body,mode:'program',enabled:[...CAPABILITIES]}},recent:[]};
const payload=()=>({context,reason:'test',repairProtocol:true});
const headers=()=>({'content-type':'application/json',origin:base,'x-gs-token':token});
test.before(async()=>{mock=http.createServer(async(req,res)=>{calls++;let bufs=[];for await(const b of req)bufs.push(b);request=JSON.parse(Buffer.concat(bufs));const out=calls===1?{title:'invalid',actions:[{kind:'move',x:16,y:10}]}:{title:'corrected',actions:[{kind:'deposit',amount:1}]};res.writeHead(200,{'content-type':'application/json'});res.end(JSON.stringify({model:'local-test',choices:[{message:{content:JSON.stringify(out)}}],usage:{prompt_tokens:11,completion_tokens:13}}));});mock.listen(0,'127.0.0.1');await once(mock,'listening');const reserve=http.createServer();reserve.listen(0,'127.0.0.1');await once(reserve,'listening');const port=reserve.address().port;await new Promise(r=>reserve.close(r));base=`http://127.0.0.1:${port}`;
child=spawn(process.execPath,['server.mjs'],{cwd:fileURLToPath(new URL('..',import.meta.url)),env:{...process.env,PORT:String(port),TYPESAFE_API_KEY:'',LLM_API_KEY:'TEST_ONLY',LLM_MODEL:'local-test',LLM_URL:`http://127.0.0.1:${mock.address().port}/chat`,MAX_SERVER_CALLS:'2'},stdio:'ignore'});for(let i=0;i<100;i++){try{const r=await fetch(base+'/api/status');if(r.ok){token=(await r.json()).token;return;}}catch{}await new Promise(r=>setTimeout(r,25));}throw Error('start');});
test.after(async()=>{child?.kill();await new Promise(r=>mock.close(r));});
test('v021 HTTP rejection preserves provider usage and failed step',async()=>{const r=await fetch(base+'/api/program',{method:'POST',headers:headers(),body:JSON.stringify(payload())});assert.equal(r.status,422);const p=await r.json();assert.equal(p.rejection.failedStep,1);assert.equal(p.usage.inputTokens,11);context.repairFeedback={attempt:1,rejection:p.rejection};});
test('v021 validator feedback actually reaches provider on correction',async()=>{const r=await fetch(base+'/api/program',{method:'POST',headers:headers(),body:JSON.stringify(payload())});assert.equal(r.status,200);const a=await r.json();assert.equal(a.output.body.program.steps.length,1);const forwarded=JSON.parse(request.messages[1].content);assert.equal(forwarded.validationFeedback.rejection.failedStep,1);});
test('v021 corrected and rejected calls both consume shared server budget',async()=>{const r=await fetch(base+'/api/program',{method:'POST',headers:headers(),body:JSON.stringify(payload())});assert.equal(r.status,429);assert.equal(calls,2);});
