import test from 'node:test';import assert from 'node:assert/strict';import http from 'node:http';import {spawn} from 'node:child_process';import {once} from 'node:events';import {fileURLToPath} from 'node:url';
import {makeSkill} from '../dist/src/skills/spec.js';import {createWorld} from '../dist/src/game/world.js';
let child,mock,base,token,calls=0,request;
const state=createWorld('guarded'),spec=makeSkill('access-open',['place-resource','wait-access'],'llm');
const payload={state,binding:{targetId:state.guards[0].id,targetBerryIds:state.berries.map(b=>b.id),amount:0}};
const headers=()=>({'content-type':'application/json',origin:base,'x-gs-token':token});
test.before(async()=>{mock=http.createServer(async(req,res)=>{calls++;let bufs=[];for await(const b of req)bufs.push(b);request=JSON.parse(Buffer.concat(bufs));const out=calls===1?{...spec,maxSteps:999}:spec;res.writeHead(200,{'content-type':'application/json'});res.end(JSON.stringify({model:'local-test-v03',choices:[{message:{content:JSON.stringify(out)}}],usage:{prompt_tokens:11,completion_tokens:13}}));});mock.listen(0,'127.0.0.1');await once(mock,'listening');const reserve=http.createServer();reserve.listen(0,'127.0.0.1');await once(reserve,'listening');const port=reserve.address().port;await new Promise(r=>reserve.close(r));base=`http://127.0.0.1:${port}`;
child=spawn(process.execPath,['server.mjs'],{cwd:fileURLToPath(new URL('..',import.meta.url)),env:{...process.env,PORT:String(port),TYPESAFE_API_KEY:'',LLM_API_KEY:'TEST_ONLY',LLM_MODEL:'local-test-v03',LLM_URL:`http://127.0.0.1:${mock.address().port}/chat`,MAX_SERVER_CALLS:'2'},stdio:'ignore'});for(let i=0;i<100;i++){try{const r=await fetch(base+'/api/status');if(r.ok){token=(await r.json()).token;return;}}catch{}await new Promise(r=>setTimeout(r,25));}throw Error('start');});
test.after(async()=>{child?.kill();await new Promise(r=>mock.close(r));});
test('v03 HTTP model route requires same-origin authorization',async()=>{const r=await fetch(base+'/api/reactive-plan',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(payload)});assert.equal(r.status,403);assert.equal(calls,0);});
test('v03 HTTP malformed skill rejection preserves actual provider usage',async()=>{const r=await fetch(base+'/api/reactive-plan',{method:'POST',headers:headers(),body:JSON.stringify(payload)});assert.equal(r.status,422);const p=await r.json();assert.equal(p.rejection.stage,'skill-schema');assert.equal(p.usage.inputTokens,11);payload.feedback=p.rejection;});
test('v03 HTTP repaired JSON contract successfully returns to runtime',async()=>{const r=await fetch(base+'/api/reactive-plan',{method:'POST',headers:headers(),body:JSON.stringify(payload)});assert.equal(r.status,200);assert.equal((await r.json()).output.schema,'gs/skill/v1');assert.equal(JSON.parse(request.messages[1].content).validationFeedback.stage,'skill-schema');});
test('v03 HTTP global call budget includes rejected and corrected attempts',async()=>{const r=await fetch(base+'/api/reactive-plan',{method:'POST',headers:headers(),body:JSON.stringify(payload)});assert.equal(r.status,429);assert.equal(calls,2);});
