+/** Separate the local game and judgment fixture visually; do not mutate either session. */
+export function mountWorkspaceNavigation(){
+ const shell=document.querySelector<HTMLElement>('main.shell')!,lab=document.getElementById('decision-lab')!;
+ const game=document.createElement('section');game.id='local-game';game.setAttribute('role','tabpanel');game.setAttribute('aria-labelledby','local-tab-game');
+ for(const child of [...shell.children])if(child!==lab)game.append(child);
+ lab.setAttribute('role','tabpanel');lab.setAttribute('aria-labelledby','local-tab-judgment');lab.hidden=true;
+ const nav=document.createElement('div');nav.className='local-scope-nav';nav.innerHTML=`<div><span class="local-kicker">本地试玩 · 浏览器独立世界</span><p>完整任务与判断实验分开查看，不与服务端会话混用。</p></div><div class="local-tabs" role="tablist" aria-label="本地实验范围"><button id="local-tab-game" role="tab" aria-selected="true" aria-controls="local-game" tabindex="0">完整任务体验</button><button id="local-tab-judgment" role="tab" aria-selected="false" aria-controls="decision-lab" tabindex="-1">判断组合实验</button></div>`;
+ shell.prepend(nav,game);document.body.dataset.localScope='game';
+ function select(which:string){const isGame=which==='game';game.hidden=!isGame;lab.hidden=isGame;document.body.dataset.localScope=which;
+ for(const [id,on]of [['local-tab-game',isGame],['local-tab-judgment',!isGame]] as const){const b=document.getElementById(id)!;b.setAttribute('aria-selected',String(on));b.tabIndex=on?0:-1;}
+ }
+ for(const [id,scope]of [['local-tab-game','game'],['local-tab-judgment','judgment']]){const b=document.getElementById(id!)!;b.onclick=()=>select(scope!);b.onkeydown=e=>{if(['ArrowRight','ArrowLeft','Home','End'].includes(e.key)){e.preventDefault();const next=e.key==='Home'?'game':e.key==='End'?'judgment':document.body.dataset.localScope==='game'?'judgment':'game';select(next);document.getElementById('local-tab-'+next)?.focus();}};}
+ const controls=lab.querySelector('.lab-controls'),options=lab.querySelector('.lab-options');
+ const detail=document.createElement('details');detail.className='local-lab-advanced';detail.innerHTML='<summary>高级实验条件 · 延迟、截止与观察</summary><div class="local-lab-fields"></div>';
+ const fields=detail.querySelector('.local-lab-fields')!;for(const id of ['lab-delay','lab-deadline']){const label=document.getElementById(id)?.closest('label');if(label)fields.append(label);}if(options)fields.append(options);controls?.after(detail);
+ const selectMode=document.getElementById('run-mode') as HTMLSelectElement;
+ const groups=[['反应技能',['reactive','reactive-off','reactive-record','reactive-jev','reactive-live']],['明确的对照实现',['program','rules-full','program-jev','program-live']],['历史配置兼容',['adaptive','fixed','jev-template','live']]] as const;
+ for(const [name,values]of groups){const optgroup=document.createElement('optgroup');optgroup.label=name;for(const value of values){const opt=[...selectMode.options].find(o=>o.value===value);if(opt){opt.textContent=opt.textContent?.replace(/^v[\d.]+\s*/,'')??value;optgroup.append(opt);}}selectMode.append(optgroup);}
+ for(const opt of [...(document.getElementById('decision-style') as HTMLSelectElement).options])opt.textContent=opt.textContent?.replace(/^v[\d.]+\s*/,'')??opt.value;
+ const styleLabel=document.querySelector('label[for="decision-style"]');if(styleLabel)styleLabel.textContent='技能模式的判断组织';
+ const heading=document.querySelector('#connect-dialog h2');if(heading)heading.textContent='运行配置';
+ const btn=document.getElementById('btn-connect');if(btn){btn.title='运行配置';const txt=btn.querySelector('.btn-text');if(txt)txt.textContent='运行配置';}
+ const link=document.createElement('a');link.href='/lab';link.className='local-shared-link';link.textContent='打开共享实验观测台 ↗';
+ if(location.protocol==='http:'||location.protocol==='https:')nav.append(link);
+}
diff --git a/tests/presentation043.test.mjs b/tests/presentation043.test.mjs
--- /dev/null
+++ b/tests/presentation043.test.mjs
@@ -0,0 +1,33 @@
+import test from 'node:test';import assert from 'node:assert/strict';
+import {ExperimentManager} from '../dist/src/lab/manager.js';
+import {actionsFor,statusCopy,reasonText,goalOf,titleOf,actualSource,flowOf,replayStates,keyEvents,decisionsFrom,isView,esc,duration} from '../dist/src/lab/presentation.js';
+const actor={id:'human:ui-test',kind:'human',label:'UI test'};
+async function fixture(t,config={}){const m=new ExperimentManager();t.after(()=>m.close());const c=await m.create({requestId:crypto.randomUUID(),actor,config});return m.get(c.runId);}
+const cmd=(r,action)=>r.command({commandId:crypto.randomUUID(),actor,expectedControlVersion:r.controlVersion,action});
+test('043 game title and goal ignore compatibility task=energy',async t=>{const r=await fixture(t,{kind:'game'}),v=r.view();assert.equal(titleOf(v.config),'守卫果园');assert(!goalOf(v).includes('35'));assert(goalOf(v).includes('5'));});
+test('043 judgment contracts keep reserve and energy distinctions',async t=>{const a=await fixture(t,{task:'energy'}),b=await fixture(t,{task:'reserve'});assert(goalOf(a.view()).includes('35'));assert(goalOf(b.view()).includes('2'));});
+test('043 owner sees start and step at ready boundary',async t=>{const r=await fixture(t),a=actionsFor(r.view(),actor.id);assert.deepEqual(a.visible,['start','step']);assert(a.enabled.step);});
+test('043 nonowner only sees explicit takeover',async t=>{const r=await fixture(t),a=actionsFor(r.view(),'agent:other');assert.deepEqual(a.visible,['takeover']);assert(!a.enabled.step);assert(a.enabled.takeover);});
+test('043 active step cannot be duplicated from UI',async t=>{const r=await fixture(t),v=r.view();v.busy=true;v.status='stepping';const a=actionsFor(v,actor.id);assert(!a.enabled.step);assert(a.enabled.pause);});
+test('043 blocked differs from ordinary paused',async t=>{const r=await fixture(t),v=r.view();v.status='blocked';v.reason='decision_blocked:no_local_suitable_action';assert(!actionsFor(v,actor.id).enabled.start);assert.deepEqual(actionsFor(v,actor.id).visible,[]);assert(statusCopy(v).body.includes('不能作为普通暂停继续'));v.status='paused';assert(actionsFor(v,actor.id).enabled.start);});
+for(const status of ['succeeded','failed','blocked','cancelled','stopped','fault'])test('043 terminal '+status+' never exposes resume',async t=>{const v=(await fixture(t)).view();v.status=status;const a=actionsFor(v,actor.id);assert(!a.enabled.start);assert(!a.enabled.cancel);assert(!a.enabled.takeover);});
+for(const flag of ['replay','imported','pending'])test('043 '+flag+' disables all server mutation controls',async t=>{const v=(await fixture(t)).view();const a=actionsFor(v,actor.id,{[flag]:true});assert(Object.values(a.enabled).every(x=>!x));});
+test('043 disconnected observer cannot command a stale state',async t=>{const v=(await fixture(t)).view();assert(Object.values(actionsFor(v,actor.id,{connected:false}).enabled).every(x=>!x));});
+test('043 model configured but not called is not presented as measured',async t=>{const v=(await fixture(t)).view();v.config.backend='jev';assert(actualSource(v).includes('尚无'));});
+test('043 test provider remains labeled even with jev config',async t=>{const v=(await fixture(t)).view();v.config.backend='jev';v.lastDecision={source:'test-provider',externalRequests:0};assert(actualSource(v).includes('测试替身'));});
+test('043 real external request count not S interface count',async t=>{const v=(await fixture(t)).view();v.requests=50;assert(actualSource(v).includes('无真实'));v.externalRequests=2;assert(actualSource(v).startsWith('2 次'));});
+test('043 exact known reason mapped without hiding raw value',()=>{assert.equal(reasonText('decision_blocked:no_local_suitable_action'),'子层未选出适用动作');assert.equal(reasonText('repair_budget_exhausted'),'技能修复预算已耗尽');assert.equal(reasonText(null),'');});
+test('043 unknown cause is not fabricated as budget failure',()=>assert(!reasonText('new_unrecognized_error').includes('预算')));
+test('043 task context uses registered immediate objective not object stringify',async t=>{const v=(await fixture(t,{kind:'game'})).view();v.activeSkill={spec:{title:'技能',phases:[{rule:'place-resource'}]},phase:0};v.lastDecision={packet:{taskContext:{immediateObjective:{description:'到达站位之前先接近。'}}}};assert.equal(flowOf(v).immediate,'到达站位之前先接近。');});
+test('043 literal strings safely escaped',()=>assert.equal(esc('<img onerror="oops">'), '&lt;img onerror=&quot;oops&quot;&gt;'));
+test('043 duration supports null-free readable units',()=>{assert.equal(duration(50),'50 ms');assert.equal(duration(1532),'1.5 秒');assert.equal(duration(65000),'1 分 5 秒');assert.equal(duration(NaN),'—');});
+test('043 replay stores full snapshots, not final metrics on initial map',async t=>{const r=await fixture(t);await cmd(r,'step');await cmd(r,'step');const frames=replayStates(r.export());assert.equal(frames[0].world.energy,10);assert.equal(frames[0].requests,0);assert.equal(frames[0].status,'ready');assert.equal(frames.at(-1).world.energy,40);assert.equal(frames.at(-1).status,'succeeded');assert(frames.at(-1).requests>0);});
+test('043 historical skill and candidate state kept together',async t=>{const r=await fixture(t);await cmd(r,'step');const frames=replayStates(r.export());assert.equal(frames[0].lastDecision,null);assert(frames.at(-1).lastDecision);});
+test('043 no state snapshots fall back only to labelled final state',async t=>{const r=await fixture(t);const frames=replayStates({initial:{energy:999},state:r.view(),events:[]});assert.equal(frames.length,1);assert.equal(frames[0].world.energy,10);});
+test('043 invalid replay does not invent states',()=>assert.equal(replayStates({state:{},events:[]}).length,0));
+test('043 UI projection and replay never mutate engine evidence',async t=>{const r=await fixture(t);await cmd(r,'step');const report=r.export(),before=JSON.stringify(report);const frames=replayStates(report);frames[0].world.energy=0;keyEvents(report.events);statusCopy(report.state);decisionsFrom(report.events,report.state);assert.equal(JSON.stringify(report),before);});
+test('043 timeline does not leak later evidence into replay',async t=>{const r=await fixture(t);await cmd(r,'step');await cmd(r,'step');const old=replayStates(r.export())[0];const keys=keyEvents(r.events,old.lastSeq);assert(!keys.some(e=>e.title==='任务完成'));});
+test('043 repeated forwarded skill event aggregated but preserved as raw evidence',()=>{const d={runId:'child',localSucceeded:true,outcome:{steps:2}};const e={runId:'r',seq:1,at:'now',type:'engine',data:{event:{type:'skill_summary',data:d}}};const es=[e,{...e,seq:2,data:{event:{type:'parent_event',data:{event:{type:'skill_summary',data:d}}}}}];assert.equal(keyEvents(es).length,1);assert.equal(es.length,2);});
+test('043 actual judgment fixture choice read from recorded selector answer',async t=>{const r=await fixture(t);await cmd(r,'step');const ds=decisionsFrom(r.events,r.view());assert.equal(ds.at(-1).status,'selected');assert(ds.at(-1).choice);assert.equal(ds.at(-1).externalRequests,0);});
+test('043 no success claim created by reading presentation functions',async t=>{const r=await fixture(t);for(let i=0;i<15;i++){statusCopy(r.view());flowOf(r.view());actionsFor(r.view(),actor.id);keyEvents(r.events);}assert.equal(r.view().requests,0);assert.equal(r.view().status,'ready');});
+test('043 state reader accepts only expected hosted shape',async t=>{const v=(await fixture(t)).view();assert(isView(v));assert(!isView({world:{}}));v.world.width=999;assert(!isView(v));});
