{
  "schema": "gs/adaptation-output-contract/v2",
  "frameKind": "action",
  "instructions": "Return exactly one JSON object with a proposals ARRAY. Each array item IS the patch object. Do NOT output envelope, actionFrame, Stage, or reframeFrame wrapper keys. These were documentation labels, not fields.",
  "jsonSchema": {
    "type": "object",
    "properties": {
      "proposals": {
        "type": "array",
        "items": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "program"
                },
                "program": {
                  "type": "object",
                  "properties": {
                    "schema": {
                      "const": "gs/decision-program/v1"
                    },
                    "title": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100,
                      "pattern": "\\S"
                    },
                    "stages": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 100,
                            "pattern": "\\S"
                          },
                          "question": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 1200,
                            "pattern": "\\S",
                            "description": "Local question for S, not an executed command."
                          },
                          "hypothesis": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 1500,
                            "pattern": "\\S",
                            "description": "Unverified G hypothesis, never an observed fact."
                          },
                          "groups": {
                            "type": "array",
                            "items": {
                              "enum": [
                                "self",
                                "nearby",
                                "map",
                                "objects",
                                "history"
                              ]
                            },
                            "minItems": 0,
                            "maxItems": 5,
                            "uniqueItems": true
                          },
                          "ruleIds": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 120,
                              "enum": [
                                "goal",
                                "coordinates",
                                "energy",
                                "inventory",
                                "drop",
                                "guard",
                                "danger",
                                "wait",
                                "knowledge"
                              ]
                            },
                            "minItems": 0,
                            "maxItems": 20,
                            "uniqueItems": true
                          },
                          "kinds": {
                            "type": "array",
                            "items": {
                              "enum": [
                                "move",
                                "pickup",
                                "eat",
                                "deposit",
                                "drop",
                                "wait"
                              ]
                            },
                            "minItems": 1,
                            "maxItems": 6,
                            "uniqueItems": true
                          },
                          "target": {
                            "anyOf": [
                              {
                                "type": "null"
                              },
                              {
                                "type": "object",
                                "properties": {
                                  "x": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 16
                                  },
                                  "y": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 10
                                  }
                                },
                                "required": [
                                  "x",
                                  "y"
                                ],
                                "additionalProperties": false
                              }
                            ]
                          },
                          "candidateIds": {
                            "anyOf": [
                              {
                                "type": "null"
                              },
                              {
                                "type": "array",
                                "items": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 120,
                                  "pattern": "^(?!__proto__$).+"
                                },
                                "minItems": 0,
                                "maxItems": 40,
                                "uniqueItems": true
                              }
                            ]
                          },
                          "until": {
                            "type": "array",
                            "items": {
                              "anyOf": [
                                {
                                  "type": "object",
                                  "properties": {
                                    "kind": {
                                      "const": "at"
                                    },
                                    "x": {
                                      "type": "integer",
                                      "minimum": 0,
                                      "maximum": 16
                                    },
                                    "y": {
                                      "type": "integer",
                                      "minimum": 0,
                                      "maximum": 10
                                    }
                                  },
                                  "required": [
                                    "kind",
                                    "x",
                                    "y"
                                  ],
                                  "additionalProperties": false
                                },
                                {
                                  "type": "object",
                                  "properties": {
                                    "kind": {
                                      "const": "delta"
                                    },
                                    "field": {
                                      "type": "string",
                                      "enum": [
                                        "bag",
                                        "delivered",
                                        "eaten",
                                        "baitUsed",
                                        "turn"
                                      ]
                                    },
                                    "atLeast": {
                                      "type": "integer",
                                      "minimum": 1,
                                      "maximum": 180
                                    }
                                  },
                                  "required": [
                                    "kind",
                                    "field",
                                    "atLeast"
                                  ],
                                  "additionalProperties": false
                                },
                                {
                                  "type": "object",
                                  "properties": {
                                    "kind": {
                                      "const": "value"
                                    },
                                    "field": {
                                      "type": "string",
                                      "enum": [
                                        "bag",
                                        "delivered",
                                        "energy",
                                        "lureCount",
                                        "guardEating"
                                      ]
                                    },
                                    "op": {
                                      "enum": [
                                        "gte",
                                        "lte",
                                        "eq"
                                      ]
                                    },
                                    "value": {
                                      "type": "integer",
                                      "minimum": 0,
                                      "maximum": 180
                                    }
                                  },
                                  "required": [
                                    "kind",
                                    "field",
                                    "op",
                                    "value"
                                  ],
                                  "additionalProperties": false
                                }
                              ],
                              "description": "All until predicates must hold. delta compares current state with the beginning of THIS stage; value compares current absolute state. baitUsed is delta-only; do not silently substitute one meaning for another."
                            },
                            "minItems": 1,
                            "maxItems": 4
                          },
                          "maxActions": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 180
                          }
                        },
                        "required": [
                          "name",
                          "question",
                          "hypothesis",
                          "groups",
                          "ruleIds",
                          "kinds",
                          "target",
                          "candidateIds",
                          "until",
                          "maxActions"
                        ],
                        "additionalProperties": false
                      },
                      "minItems": 1,
                      "maxItems": 8
                    }
                  },
                  "required": [
                    "schema",
                    "title",
                    "stages"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
