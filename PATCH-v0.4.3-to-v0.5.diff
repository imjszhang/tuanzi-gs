+/** Recursive G/S repair controller. No environment solver, reward oracle or model-specific logic.
+ * S is allowed to abstain or be wrong. G changes the decision interface; S still selects.
+ * Each recursive level selects a patch to its parent. All levels share the caller's budget.
+ */
+export type AdaptiveOption = {id:string; description:string; value:unknown};
+export type AdaptiveFrame = {kind:'action'|'reframe'; question:string; context:unknown; options:AdaptiveOption[]; revision:string};
+export type AdaptiveAnswer = {choice:string|null; detail:unknown};
+export type AdaptivePatch = {id:string; description:string; value:unknown};
+export type AdaptationRequest = {schema:'gs/adaptation-request/v1'; depth:number; cause:string; frame:AdaptiveFrame; answer:AdaptiveAnswer|null; previous:unknown[]; evidence:unknown};
+export type AdaptiveEvent = {type:string; data:unknown};
+export type AdaptiveResolution = {kind:'selected'; frame:AdaptiveFrame; choice:string; answer:AdaptiveAnswer}|{kind:'blocked';reason:string;frame:AdaptiveFrame};
+export interface AdaptivePorts {
+  select(frame:AdaptiveFrame,depth:number,signal:AbortSignal):Promise<AdaptiveAnswer>;
+  generate(request:AdaptationRequest,signal:AbortSignal):Promise<unknown>;
+  parse(raw:unknown,frame:AdaptiveFrame):AdaptivePatch[];
+  apply(frame:AdaptiveFrame,patch:AdaptivePatch,depth:number):AdaptiveFrame;
+  evidence():unknown;
+  check(revision:string,signal:AbortSignal):void;
+  event(e:AdaptiveEvent):void;
+}
+export class InvalidAdaptation extends Error {override name='InvalidAdaptation';}
+export class AdaptiveStale extends Error {override name='AdaptiveStale';}
+function canonical(x:unknown):string { if(x===undefined)return 'null'; if(x===null||typeof x!=='object')return JSON.stringify(x);if(Array.isArray(x))return `[${x.map(canonical).join(',')}]`;return `{${Object.keys(x).sort().map(k=>`${JSON.stringify(k)}:${canonical((x as Record<string,unknown>)[k])}`).join(',')}}`;}
+export function frameSignature(f:AdaptiveFrame):string{return canonical({kind:f.kind,question:f.question,context:f.context,options:f.options.map(o=>({id:o.id,description:o.description,value:o.value}))});}
+export class AdaptiveGS {
+  readonly limits:{maxDepth:number;maxRevisions:number;maxGenerations:number;ioTimeoutMs:number};
+  private busy=false;
+  constructor(private readonly ports:AdaptivePorts,limits:Partial<AdaptiveGS['limits']>={}){
+    this.limits={maxDepth:2,maxRevisions:3,maxGenerations:8,ioTimeoutMs:120000,...limits};
+    for(const [k,v]of Object.entries(this.limits))if(!Number.isSafeInteger(v)||v<1||v>(k==='ioTimeoutMs'?3600000:32))throw Error(`Invalid adaptive limit ${k}`);
+  }
+  async resolve(frame:AdaptiveFrame,signal:AbortSignal,initialCause?:string):Promise<AdaptiveResolution>{
+    if(this.busy)throw Error('adaptive_concurrent_resolve');this.busy=true;
+    const budget={generated:0};
+    try{return await this.loop(structuredClone(frame),0,signal,budget,initialCause);}
+    finally{this.busy=false;}
+  }
+  private async io<T>(revision:string,signal:AbortSignal,fn:(s:AbortSignal)=>Promise<T>):Promise<T>{
+    this.ports.check(revision,signal);const local=new AbortController();const combined=AbortSignal.any([signal,local.signal]);
+    let timer:ReturnType<typeof setTimeout>|undefined;let abort:()=>void=()=>{};
+    const stopped=new Promise<never>((_,reject)=>{abort=()=>reject(combined.reason??Error('aborted'));combined.addEventListener('abort',abort,{once:true});timer=setTimeout(()=>local.abort(Error('adaptive_io_timeout')),this.limits.ioTimeoutMs);});
+    try{const result=await Promise.race([Promise.resolve().then(()=>fn(combined)),stopped]);this.ports.check(revision,combined);return result;}
+    finally{if(timer)clearTimeout(timer);combined.removeEventListener('abort',abort);}
+  }
+  private async loop(start:AdaptiveFrame,depth:number,signal:AbortSignal,budget:{generated:number},firstCause?:string):Promise<AdaptiveResolution>{
+    let frame=start,cause=firstCause;const seen=new Set([frameSignature(frame)]);const history:unknown[]=[];
+    for(let attempt=0;attempt<=this.limits.maxRevisions;attempt++){
+      this.ports.check(frame.revision,signal);let answer:AdaptiveAnswer|null=null;
+      if(!cause&&frame.options.length){
+        this.ports.event({type:'s_requested',data:{depth,frame}});
+        answer=await this.io(frame.revision,signal,s=>this.ports.select(frame,depth,s));
+        this.ports.event({type:'s_answered',data:{depth,frame,answer}});
+        if(answer.choice!==null){if(!frame.options.some(o=>o.id===answer!.choice))throw Error('selector_unoffered_choice');return {kind:'selected',frame,choice:answer.choice,answer};}
+        cause='selector_abstained';
+      }
+      cause??='candidate_gap';
+      this.ports.event({type:'adaptation_needed',data:{depth,cause,attempt,answer}});
+      if(depth>=this.limits.maxDepth)return {kind:'blocked',reason:'adaptation_depth_exhausted',frame};
+      if(attempt>=this.limits.maxRevisions||budget.generated>=this.limits.maxGenerations)return {kind:'blocked',reason:'adaptation_budget_exhausted',frame};
+      const request:AdaptationRequest={schema:'gs/adaptation-request/v1',depth,cause,frame,answer,previous:structuredClone(history.slice(-4)),evidence:this.ports.evidence()};
+      if(new TextEncoder().encode(JSON.stringify(request)).byteLength>220000)return {kind:'blocked',reason:'adaptation_input_budget_exhausted',frame};
+      budget.generated++;this.ports.event({type:'g_requested',data:request});
+      let patches:AdaptivePatch[];
+      try{const raw=await this.io(frame.revision,signal,s=>this.ports.generate(request,s));this.ports.event({type:'g_proposed',data:{depth,output:raw}});patches=this.ports.parse(raw,frame);}
+      catch(e){if(!(e instanceof InvalidAdaptation))throw e;const rejected={reason:e.message};history.push(rejected);this.ports.event({type:'adaptation_rejected',data:{depth,...rejected}});cause='invalid_proposal';continue;}
+      if(!patches.length)return {kind:'blocked',reason:'generator_no_proposal',frame};
+      const alternatives:AdaptiveFrame={kind:'reframe',revision:frame.revision,
+        question:'Which proposed change should be tried to improve the lower S decision? Judge hypotheses against allowed evidence. None remains available. This choice does not itself execute a world action.',
+        context:{rootIssue:cause,lowerFrame:frame,lowerAnswer:answer,previous:history.slice(-3)},
+        options:patches.map((p,i)=>({id:`patch-${i}`,description:p.description,value:p}))};
+      this.ports.event({type:'meta_enter',data:{depth:depth+1,parentDepth:depth,candidates:alternatives.options.length}});
+      const higher=await this.loop(alternatives,depth+1,signal,budget);
+      this.ports.event({type:'meta_return',data:{depth:depth+1,result:higher.kind,reason:higher.kind==='blocked'?higher.reason:null}});
+      if(higher.kind==='blocked')return {kind:'blocked',reason:higher.reason,frame};
+      const selected=higher.frame.options.find(x=>x.id===higher.choice);
+      if(!selected)throw Error('lost_meta_option');
+      const patch=selected.value as AdaptivePatch;let next:AdaptiveFrame;
+      try{next=this.ports.apply(frame,patch,depth);}
+      catch(e){if(!(e instanceof InvalidAdaptation))throw e;history.push({reason:e.message});cause='invalid_application';continue;}
+      if(next.revision!==frame.revision||next.kind!==frame.kind)throw Error('adaptation_changed_authority');
+      const signature=frameSignature(next);
+      if(seen.has(signature)){history.push({reason:'duplicate_decision_no_change',proposal:patch.value});this.ports.event({type:'adaptation_rejected',data:{depth,reason:'duplicate_decision_no_change'}});cause='duplicate_decision_no_change';continue;}
+      seen.add(signature);history.push({cause,previousQuestion:frame.question,previousAnswer:answer,applied:patch.value});
+      this.ports.event({type:'adaptation_committed',data:{depth,before:frame,after:next,patch:patch.value}});frame=next;cause=undefined;
+    }
+    return {kind:'blocked',reason:'adaptation_budget_exhausted',frame};
+  }
+}
