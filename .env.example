# Optional. Offline mode does NOT need API credentials.
PORT=4173
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0

# A configured Chat Completions-compatible endpoint; no provider is called by default.
LLM_API_KEY=
LLM_MODEL=
LLM_URL=
# Set false only for providers that do not accept response_format.
LLM_JSON_MODE=true

# Server-wide cap on attempts since last server start, not a dollar-spend cap.
MAX_SERVER_CALLS=200

# Explicit --live CLI benchmark only. Attempts, not a dollar-spend limit.
MAX_BENCH_CALLS=120
# Optional model for fixed-candidate comparison. Defaults to LLM_MODEL.
LLM_SELECTOR_MODEL=

# Shared experiment reports (created by the local service)
# GS_LAB_OUTPUT_DIR=.gs-lab/exports

# v0.5 generator optional provider-specific extensions, sent ONLY when configured:
# LLM_THINKING=enabled
# LLM_REASONING_EFFORT=low
# Remove unsupported extensions rather than silently falling back to another model.

# v0.5.1: G streaming only. These do not change S/Jev's structured judgment protocol.
# true by default. Set false for an endpoint that rejects the stream parameter.
LLM_STREAM=true
# Optional; send stream_options.include_usage ONLY when explicitly enabled.
# Endpoints may report tail usage regardless; unknown usage remains unknown.
LLM_STREAM_INCLUDE_USAGE=false
# Existing thinking/reasoning options above stay opt-in; streaming does not enable them.
