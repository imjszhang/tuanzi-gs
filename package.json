{
  "name": "tuanzi-gs-lab",
  "version": "0.5.5",
  "private": true,
  "type": "module",
  "description": "\u522b\u8ba9\u56e2\u5b50\u997f\u6b7b \u2014 a transparent, playable domain adapter for the G/S TypeScript runtime",
